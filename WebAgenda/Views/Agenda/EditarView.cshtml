@model WebAgenda.Models.ContactoViewModel

@{
    ViewBag.Title = "EditarView";
}

<h2>EditarView</h2>


@using (Html.BeginForm("Editar", "Agenda", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>ContactoViewModel</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <input type="hidden" name="IdUsuario" value="@Model.IdUsuario" />
        <input type="hidden" name="IdContacto" value="@Model.IdContacto" />

        <div class="form-group">
            @Html.LabelFor(model => model.Nombre, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.ApellidoPaterno, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.ApellidoPaterno, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ApellidoPaterno, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.ApellidoMaterno, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.ApellidoMaterno, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ApellidoMaterno, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.FechaNacimiento, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.FechaNacimiento, new { htmlAttributes = new { type = "date", @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.FechaNacimiento, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Foto, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12 mt-4">
                    @*<img src="~/Imagenes/@Model.Foto" class="rounded-circle" width="145" height="145" />*@
                    @if (@Model.Foto.Any())
                    {
                        <img src="~/Imagenes/@Model.Foto" class="rounded-circle" width="145" height="145" />
                    }
                    else
                    {
                        <img src="~/Imagenes/wertyujkedfmncvhgchdjskasdmvnhcjdsmnfhjdks,dmsfjrsjenmlas.jpg" class="rounded-circle" width="145" height="145" />
                    }
                    <div class="col-md-10">
                        <input type="hidden" name="Foto" value="@Model.Foto" />
                        <input type="file" name="ArchivoImagen" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Telefono, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Telefono, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Telefono, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
            </div>
        </div>

        <br />
        <div class="form-group">
            Agregar Red Social
        </div>

        <div class="d-flex align-items-center mb-2 gap-2">
            <input type="checkbox" id="chkAgregarRed" />
            @Html.DropDownList("RedSocialOpciones", null, htmlAttributes: new { id = "red", @class = "form-control form-control-sm w-auto", disabled = "disabled" })
            <input type="text" id="perfil" placeholder="Usuario URL" class="form-control form-control-sm w-auto" disabled />
            <button id="btn" type="button" class="btn btn-primary btn-sm" disabled>Agregar Perfil</button>
        </div>

        <div id="contenedor">

            @for (int i = 0; i < Model.Perfil.Count; i++)
            {
                var listaRedes = (List<SelectList>)ViewBag.IdRedSocial;
                <div class="perfil-item">
                    <div class="d-flex align-items-center mb-2 gap-2">
                        <input type="hidden" name="IdPerfil[]" value="@Model.IdPerfil[i]" />
                        @*<input type="hidden" name="IdRedSocial[]" value="@Model.IdRedSocial[i]" />*@
                        <input type="hidden" name="RedSocial[]" value="@Model.RedSocial[i]" />
                        @*<span class="form-control form-control-sm w-auto">@Model.RedSocial[i]</span>*@
                        @Html.DropDownList($"IdRedSocial[]", listaRedes[i], htmlAttributes: new { id = "red", @class = "form-control form-control-sm w-auto" })
                        <input type="text" name="Perfil[]" value="@Model.Perfil[i]" class="form-control form-control-sm w-auto" />
                        <a href="/Agenda/EliminarPerfil?idPerfil=@Model.IdPerfil[i]&idContacto=@Model.IdContacto" class="btn btn-warning btn-sm" onclick="return confirm('El perfil se eliminara permanetemente, estas seguro?')">Eliminar</a>
                    </div>
                </div>
            }

        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-default" formaction="/Agenda/Editar" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const chk = document.getElementById('chkAgregarRed');
        const ddl = document.getElementById('red');
        const perfil = document.getElementById('perfil');
        const btn = document.getElementById('btn');
        const ctn = document.getElementById('contenedor');

        chk.addEventListener('change', () => {
            ddl.disabled = !chk.checked;
            perfil.disabled = !chk.checked;
            btn.disabled = !chk.checked;
            if (chk.checked === true) {
                perfil.style.borderColor = 'cornflowerblue';
                ddl.style.borderColor = 'cornflowerblue';
            }
            else {
                perfil.style.border = '';
                ddl.style.border = '';
            }
        });

        let contador = 0;

        btn.addEventListener('click', () => {
            const idred = ddl.value;
            const redName = ddl.options[ddl.selectedIndex].text;
            const user = perfil.value;

            if (!idred || !user) {
                alert("Completa todos los campos");
                return;
            }

            const div = document.createElement('div');
            div.classList.add('perfil-item');
            div.innerHTML = `
            <div class="d-flex align-items-center mb-2 gap-2">
                 <input type="hidden" name="IdRedSocial[]" value="${idred}" />
                 <span class="form-control form-control-sm w-auto">${redName}</span>
                 <input type="text" name="Perfil[]" value="${user}" class="form-control form-control-sm w-auto"/>
                 <button type="button" style="color: red;" class="btn btn-link btn-sm eliminar">Quitar</button>
            </div>
            `;
            ctn.appendChild(div);

            //contador++;
            perfil.value = '';
            ddl.selectedIndex = 0;

            //metodo
            reindexInputs
        });

        ctn.addEventListener('click', (e) => {
            if (e.target.classList.contains('eliminar')) {
                e.target.closest('.perfil-item').remove();
                //metodo
                reindexInputs
            }
        });

        function reindexInputs() {
            const perfiles = document.querySelectorAll('.perfil-item');
            perfiles.forEach((item, index) => {
                const redInput = item.querySelector('input[name^="RedSocial"]');
                const perfilInput = item.querySelector('input[name^="Perfil"]');
                redInput.name = RedSocial[index];
                perfilInput.name = Perfil[index];
            });
        }
    });
</script>

