@*@model Datos.Model.Usuario*@

@{
    ViewBag.Title = "LoginView";
}

<h2>Login</h2>

<form action="/Home/LogIn" method="post">
    <label>Usuario</label><input type="text" name="User" placeholder="example@domain.com"/><br /><br />
    <label>Password</label><input type="password" name="Password" placeholder="Password"/><br />
    <input type="submit" value="Ingresar"/><br /><br />
    <a href="/Home/UserCreateView">Crear Usuario</a>
</form>
