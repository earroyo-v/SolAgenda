<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <script src="~/Scripts/modernizr-2.6.2.js"></script>
</head>
<body>
    @{
        WebAgenda.Models.UsuarioSessionViewModel us = new WebAgenda.Models.UsuarioSessionViewModel();
        if (Session["Usuario"] != null)
        {
            us = (WebAgenda.Models.UsuarioSessionViewModel)Session["Usuario"];
        }


    }
    @*<h3>@us.NickName</h3>*@
    <nav class="navbar navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">
                @*<img src="/docs/5.3/assets/brand/bootstrap-logo.svg" alt="Logo" width="30" height="24" class="d-inline-block align-text-top">*@
                @if (us.Foto.Any())
                {
                    <img src="~/Imagenes/@us.Foto" width="25" height="25" class="rounded-circle">
                }
                else
                {
                    <img src="~/Imagenes/wertyujkedfmncvhgchdjskasdmvnhcjdsmnfhjdks,dmsfjrsjenmlas.jpg" width="25" height="25" class="rounded-circle">
                }

                @us.NickName
            </a>
            <form class="search-bar position-relative mx-auto" style="max-width: 400px;" method="get" action="/Home/Buscar">
                <input class="form-control ps-5 rounded-pill border-0 shadow-sm"
                       type="search"
                       placeholder="Buscar..."
                       aria-label="Buscar"
                       name="data">
                <span class="position-absolute top-50 start-0 translate-middle-y ps-3 text-muted">
                    <i class="bi bi-search"></i>
                </span>
            </form>
            <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasDarkNavbar" aria-controls="offcanvasDarkNavbar" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="offcanvas offcanvas-end text-bg-dark" tabindex="-1" id="offcanvasDarkNavbar" aria-labelledby="offcanvasDarkNavbarLabel">
                <div class="offcanvas-header">
                    @if (us.Foto.Any())
                    {
                        <img src="~/Imagenes/@us.Foto" width="80" height="80" class="rounded-circle">
                    }
                    else
                    {
                        <img src="~/Imagenes/wertyujkedfmncvhgchdjskasdmvnhcjdsmnfhjdks,dmsfjrsjenmlas.jpg" width="55" height="55" class="rounded-circle">
                    }
                    <h5 class="offcanvas-title" id="offcanvasDarkNavbarLabel">@us.Nombre @us.ApellidoPaterno @us.ApellidoMaterno</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body d-flex flex-column h-100">
                    <ul class="navbar-nav pe-3">
                        <li class="nav-item">
                            <a class="nav-link active" href="#">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Mi Perfil</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Opciones
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li><a class="dropdown-item" href="#">Editar informacion</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="#">Cambiar Contrasena</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="#">Eliminar Cuenta</a></li>
                            </ul>
                        </li>
                    </ul>

                    <!-- 🔻 Botón pegado al fondo -->
                    <div class="mt-auto text-end pe-3 pt-3 border-top">
                        <a class="btn btn-outline-light w-100" href="/Home/LogOut">Log Out</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    @*<a href="/Home/LogOut">Cerrar Sesion</a>*@
    <div class="container body-content">
        <br />
        @if (TempData["m"] != null)
        {
            <div class="alert alert-success small">@TempData["m"]</div>
        }
        @if (TempData["e"] != null)
        {
            <div class="alert alert-danger small">@TempData["e"]</div>
        }
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
        </footer>
    </div>

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    @*<script src="~/Scripts/bootstrap.min.js"></script>*@
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
</body>
</html>