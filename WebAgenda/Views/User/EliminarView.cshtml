@model WebAgenda.Models.UsuarioSessionViewModel

@{
    Layout = "~/Views/Shared/_LayoutAgenda.cshtml";
    ViewBag.Title = "EliminarView";
}

<h3>Are you sure you want to delete this?</h3>
<div class="card text-center">
    <div class="card-header">
        Eliminar Cuenta
    </div>
    <div class="card-body">
        <div class="row">
            <div>
                @*<img src="~/Imagenes/@Model.Foto" class="rounded-circle" width="145" height="145" />*@
                @if (@Model.Foto?.Any() == true)
                {
                    <img src="~/Imagenes/@Model.Foto" class="rounded-circle" width="145" height="145" />
                }
                else
                {
                    <img src="~/Imagenes/wertyujkedfmncvhgchdjskasdmvnhcjdsmnfhjdks,dmsfjrsjenmlas.jpg" class="rounded-circle" width="145" height="145" />
                }
            </div>
        </div>
        <h5 class="card-title">@Model.Nombre @Model.ApellidoPaterno @Model.ApellidoMaterno</h5><br />
        <p class="card-text"><strong>NickName</strong><br />@Model.NickName</p>

        <form action="/User/Eliminar/@Model.IdUsuario" method="post">
            <input type="hidden" name="IdUsuario" value="@Model.IdUsuario" />
            <input type="submit" value="Elimnar Usuario" class="btn btn-danger" onclick="return confirm('La cuenta se eliminara permanetemente, junto con sus contacto. Estas seguro de continuar?')"/>
        </form>
    </div>
    <div class="card-footer text-body-secondary">
        <a href="/Agenda/Index">Back to List</a>
    </div>
</div>
